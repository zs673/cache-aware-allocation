%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48 384.00004 108.00001] CT
[1 0 0 1 0 0] CT
N
-800 -225 M
450 -225 L
450 400 L
-800 400 L
-800 -225 L
cp
clip
GS
0 0 translate
450 400 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 400
  /ImageMatrix [450 0 0 400 0 0]
  /Width 450
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
